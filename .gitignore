# Safety net for this PARENT folder. The app itself lives in Reclaim/ (that is the folder to turn into a repo).
# If anyone ever runs "git init" here by mistake, these stay out of it.
keys.env
.mcp.json
*.jks
*.keystore
*.pepk
*.apk
*.aab

# The built app file and its checksum: the app is published as a GitHub Release, never committed to the repo.
dist/

# Local helper script, not part of the project.
publish-to-github.ps1

# Vercel's local link and token files: never commit these.
.vercel/
.env.local
.env*.local
