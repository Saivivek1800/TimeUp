<?xml version="1.0" encoding="utf-8"?>
<!-- Articles come only over HTTPS, and only certificates the phone itself trusts (no user-installed ones). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
